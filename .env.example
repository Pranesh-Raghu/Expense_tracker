# Copy to .env and adjust. docker-compose reads this file automatically.

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=expensetracker

# Must match the public URL clients will actually use to reach this server -
# it's embedded in every issued JWT (iss/aud) and in the OAuth metadata
# documents. Update this to your ngrok HTTPS URL and restart the app
# container after starting the tunnel, e.g.:
#   OAUTH_ISSUER=https://abcd1234.ngrok-free.app
OAUTH_ISSUER=http://localhost:8000

# Defaults to "$OAUTH_ISSUER/mcp" if left blank.
MCP_RESOURCE_URL=

# Only for local testing of CIMD clients hosted on http://localhost - never
# enable this against a real deployment.
CIMD_ALLOW_INSECURE_HTTP=false

# Signs the web-login JWT (password/Google/passwordless) - see auth.py.
# Leave blank to have the app generate and persist one under the oauth_keys
# volume on first boot; set this explicitly if you need the same secret
# across multiple app replicas that don't share that volume.
REST_JWT_SECRET_KEY=

# RBAC/FGA (see authz/). Comma-separated usernames to promote to admin on
# startup - the only way to become the first admin, since granting admin
# requires already being one. No-op for usernames that don't exist yet.
INITIAL_ADMIN_USERNAMES=

# Comma-separated origins allowed to call this API cross-origin (the SPA in
# frontend/ runs on a different origin in dev). Bearer-token auth only, so
# allow_credentials stays disabled regardless of what's listed here.
CORS_ORIGINS=http://localhost:5173

# Python logging level for the whole app (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# Google sign-in (see google_oauth.py). Create an OAuth 2.0 Client ID
# ("Web application" type) in Google Cloud Console > APIs & Services >
# Credentials, and add this exact URL to its "Authorized redirect URIs":
#   {OAUTH_ISSUER}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the frontend SPA is served from - Google login redirects the
# browser here (to /auth/callback) after this app mints its own JWT.
FRONTEND_URL=http://localhost:5173

# Base URL the SPA calls for the API. Leave blank for same-origin (the Vite
# dev proxy or the nginx prod config forwards it) - only set this to bypass
# the proxy, e.g. VITE_API_BASE_URL=http://localhost:8000. That path needs
# CORS_ORIGINS on the backend to include this app's own origin.
VITE_API_BASE_URL=
